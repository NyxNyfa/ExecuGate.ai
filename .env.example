# ─── Core ────────────────────────────────────────────────────────────────────
# 32-byte hex key used for AES-256-GCM encryption of secrets at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXECUGATE_MASTER_KEY=
DATABASE_PATH=./data/execugate.db
NODE_ENV=development

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_COMMANDER_CHAT_ID=
TELEGRAM_TECH_DIVISION_CHAT_ID=
TELEGRAM_OPS_DIVISION_CHAT_ID=
TELEGRAM_MODE=polling            # polling | webhook

# ─── LLM ─────────────────────────────────────────────────────────────────────
# provider: fake | openai | ollama
# For the demo laptop:  openai + LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=3000
LLM_MAX_TOKENS=900

# ─── Embeddings ──────────────────────────────────────────────────────────────
# provider: fake | openai | local
# Demo laptop: openai + EMBED_BASE_URL=http://127.0.0.1:8081/v1
#              model=intfloat/multilingual-e5-small  dims=384
EMBED_PROVIDER=fake
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIMS=384

# ─── ASR ─────────────────────────────────────────────────────────────────────
# provider: fake | whisper-http | cloud
# Demo laptop: whisper-http + ASR_BASE_URL=http://127.0.0.1:9000  ASR_MODEL=small
ASR_PROVIDER=fake
ASR_BASE_URL=http://127.0.0.1:9000
ASR_API_KEY=
ASR_MODEL=small
ASR_LANGUAGE=

# ─── Gatekeeper ──────────────────────────────────────────────────────────────
# provider: github | fake
GATEKEEPER_PROVIDER=github
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GATEKEEPER_TIMEOUT_MS=1500

# ─── Ops source of truth ─────────────────────────────────────────────────────
OPS_SOURCE_URL=
OPS_SOURCE_TOKEN=
OPS_TOLERANCE=0.01

# ─── GPU / VRAM ───────────────────────────────────────────────────────────────
# Usable VRAM on the demo laptop. ModelArbiter validates the largest single model
# footprint against this and serialises GPU-resident roles (ASR / LLM / embeddings).
VRAM_BUDGET_MB=4096

# ─── Authentication ───────────────────────────────────────────────────────────
# AUTH_MODE=dev trusts an X-Actor-User-Id header. Any caller can set that header, so
# it is a development convenience ONLY. Production refuses to start with `dev`.
#
# AUTH_MODE=token requires `Authorization: Bearer <jwt>` on every request and derives
# identity, role and organisation solely from the signed token.
#   Generate the signing key (32+ characters):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_MODE=dev
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_LOGIN_LIMIT=8
AUTH_LOGIN_WINDOW_MS=300000

# ─── API hardening ────────────────────────────────────────────────────────────
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000

# Serve the built dashboard from the API process. One origin removes CORS, proxy path
# rewriting, and dashboard/API version skew. Set to true after `npm run build:web`.
SERVE_WEB=true
WEB_DIST_DIR=./apps/web/dist

# Require TLS. Either terminate at a reverse proxy (and forward X-Forwarded-Proto) or
# set true when serving directly. Blocking in production.
REQUIRE_TLS=true

# ─── Ports ───────────────────────────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173
