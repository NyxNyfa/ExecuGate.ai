{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@execugate/core": ["./packages/core/src/index.ts"],
      "@execugate/core/*": ["./packages/core/src/*"],
      "@execugate/db": ["./packages/db/src/index.ts"],
      "@execugate/db/*": ["./packages/db/src/*"],
      "@execugate/observability": ["./packages/observability/src/index.ts"],
      "@execugate/llm": ["./packages/llm/src/index.ts"],
      "@execugate/llm/*": ["./packages/llm/src/*"],
      "@execugate/asr": ["./packages/asr/src/index.ts"],
      "@execugate/memory": ["./packages/memory/src/index.ts"],
      "@execugate/memory/*": ["./packages/memory/src/*"],
      "@execugate/channels": ["./packages/channels/src/index.ts"],
      "@execugate/channels/*": ["./packages/channels/src/*"],
      "@execugate/gatekeeper": ["./packages/gatekeeper/src/index.ts"],
      "@execugate/gatekeeper/*": ["./packages/gatekeeper/src/*"],
      "@execugate/orchestration": ["./packages/orchestration/src/index.ts"],
      "@execugate/orchestration/*": ["./packages/orchestration/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "apps/web/src"]
}
